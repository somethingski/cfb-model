# Secrets
.env

# Data and caches (regenerated by the pipeline; never committed)
data/
cache/

# Model artifacts. The fitted objects are build outputs; train_report.json is the record
# of what was searched, chosen and scored, and is committed for review.
models/*
!models/train_report.json
*.pkl
*.joblib
*.txt.model
*.lgb

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store
